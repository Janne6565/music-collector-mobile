{
  "expo": {
    "name": "Music Collector",
    "slug": "music-collector",
    "scheme": "musiccollector",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Music Collector uses the camera to scan barcodes on sleeves and cases."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Music Collector uses your photo library so you can attach pictures of your own copies.",
          "cameraPermission": "Music Collector uses the camera to photograph your sleeves and scan barcodes."
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.jannekeipert.musiccollector",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "de.jannekeipert.musiccollector",
      "adaptiveIcon": {
        "backgroundColor": "#191713",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "janne6565",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0aa09257-7b1a-416d-a2ac-e0f7882fa4e7"
      }
    }
  }
}
